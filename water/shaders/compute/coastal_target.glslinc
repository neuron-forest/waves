// Boundary options; the beach uses only offshore relaxation.
layout(std430,set=0,binding=11) readonly buffer BoundaryOptions {vec4 boundary_options;};
// Stokes-2 forcing acts only within the offshore relaxation zone.
float smooth_ramp(float q){q=clamp(q,0,1);return q*q*q*(10+q*(-15+6*q));}
float ramped_amplitude(float time){return pc.wave.x*smooth_ramp(time*pc.wave.z/(6.28318530718*pc.forcing.w));}
vec2 coastal_surface(float x,float time){
 float a=ramped_amplitude(time),k=pc.wave.y,w=pc.wave.z,h=pc.wave.w;
 float sigma=tanh(k*h),second=k*a*a*(3-sigma*sigma)/(4*sigma*sigma*sigma);
 // numerics.z selects the linear calibration target without hidden harmonics.
 if(pc.numerics.z<.5)second=0;
 float phase=k*(x-pc.forcing.x)-w*time;
 return vec2(a*cos(phase)+second*cos(2*phase),-k*a*sin(phase)-2*k*second*sin(2*phase));
}
vec3 coastal_velocity(vec3 world,float time){
 float a=ramped_amplitude(time),k=pc.wave.y,w=pc.wave.z,h=pc.wave.w;
 float s=sinh(k*h),phase=k*(world.x-pc.forcing.x)-w*time,y=world.y+h;
 float first=a*w/s,second=pc.numerics.z>.5?.75*a*a*w*k/pow(s,4):0;
 return vec3(first*cosh(k*y)*cos(phase)+second*cosh(2*k*y)*cos(2*phase),
             first*sinh(k*y)*sin(phase)+second*sinh(2*k*y)*sin(2*phase),0);
}
vec3 coastal_face_position(ivec3 q,int axis){vec3 p=center(q);p[axis]-=.5*pc.spacing_dt[axis];return p;}
vec4 coastal_plane(ivec3 q,float time){
 vec2 surface=coastal_surface(center(q).x,time);
 vec3 normal=vec3(-surface.y*pc.spacing_dt.x,pc.spacing_dt.y,0);
 return vec4(normal,dot(normal,vec3(.5))+surface.x-center(q).y);
}
float coastal_fraction(ivec3 q,float time){vec4 eq=coastal_plane(q,time);return clamp(cube_volume(eq.xyz,eq.w),0,1);}
float coastal_rate(float x){
 float left=1-smooth_ramp((x-pc.forcing.x)/pc.forcing.y);
 float right=pc.fixture.x==6?smooth_ramp((x-(pc.origin_eta.x+float(dims().x)*pc.spacing_dt.x-pc.forcing.y))/pc.forcing.y):0;
 return pc.forcing.z*max(left,boundary_options.x*right);
}
bool offshore_zone(float x){return x<pc.forcing.x+pc.forcing.y;}
