// Optional local height-integral normal. This estimates a PLIC normal only;
// it never replaces the 3D fractions with a heightfield. Five nine-cell columns
// must each contain exactly one monotone transition with pure endpoint cells.
// Solids, unresolved sheets/gaps, incomplete columns: retain weighted Youngs.
// hf_fraction / hf_valid are supplied by the owner. source selects its F bank.
vec3 height_normal(ivec3 q,vec3 youngs,vec3 spacing,int source,out bool used){
 used=false;vec3 scaled=abs(youngs)*spacing;
 int axis=scaled.x>scaled.y?0:1;if(scaled.z>scaled[axis])axis=2;
 if(scaled[axis]<1e-12)return youngs;
 int b=(axis+1)%3,d=(axis+2)%3;float orientation=sign(youngs[axis]);
 float heights[5];
 for(int column=0;column<5;column++){
  ivec3 base=q;
  if(column==1)base[b]--;if(column==2)base[b]++;
  if(column==3)base[d]--;if(column==4)base[d]++;
  float sum=0,previous=orientation>0?1:0;
  for(int t=-4;t<=4;t++){
   ivec3 cell=base;cell[axis]+=t;if(!hf_valid(cell))return youngs;
   float f=hf_fraction(cell,source);
   if(isnan(f)||isinf(f)||f<0||f>1)return youngs;
   // The small comparison tolerance only selects an estimator. It does not
   // clip occupancy, move a plane or change pressure classification.
   if(orientation*(f-previous)>2e-6)return youngs;
   if(t==-4&&f!=(orientation>0?1:0))return youngs;
   if(t==4&&f!=(orientation>0?0:1))return youngs;
   sum+=f;previous=f;
  }
  heights[column]=sum*spacing[axis];
 }
 vec3 result=vec3(0);result[axis]=orientation;
 result[b]=-(heights[2]-heights[1])/(2*spacing[b]);
 result[d]=-(heights[4]-heights[3])/(2*spacing[d]);
 used=true;return result;
}
