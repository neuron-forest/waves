// PCG iterations for the current fine pressure operator.
void pressure_iteration_pass(){
 uint i=gl_GlobalInvocationID.x;int op=int(pc.dims_op.w);ivec3 n=dims();float dt=timestep();
 if(op==3){
  if(!pressure_setup())return;
  vec4 sums=vec4(0);
  if(i<N()){
   ivec3 q=coord(i,n);float r=0,z=0,bv=0,diag=1;
   if(wet(q)){diag=diagonal(q);bv=-1000.0/dt*divergence(q);r=bv-operator_at(q,0);z=r/diag;}
   work[i]=r;work[N()+i]=z;work[2*N()+i]=z;work[4*N()+i]=diag;work[5*N()+i]=bv;
   sums=vec4(r*z,r*r,bv*bv,abs(r));
  }pressure_partial(sums);return;
 }
 if(op==4){if(!pressure_setup())return;vec4 s=global_reduce(true);if(i!=0)return;c[9]=s.x;c[10]=s.z;c[13]=sqrt(s.y/max(s.z,1e-30));if(residual_converged(s,s.z))c[6]=1;
#ifdef COUPLED
 if(c[58]==0)c[59]=s.z;
 c[57]=0;
#endif
 return;}
 if(op==5){if(!solving()||i>=N())return;ivec3 q=coord(i,n);work[3*N()+i]=wet(q)?operator_at(q,1):0;return;}
 if(op==6){if(!solving())return;sum_partial(i<N()?vec4(work[2*N()+i]*work[3*N()+i],0,0,0):vec4(0));return;}
 if(op==7){if(!solving())return;float dotp=global_reduce(false).x;if(i!=0)return;if(dotp<=0||isnan(dotp)||isinf(dotp)){c[7]=1;return;}c[11]=c[9]/dotp;return;}
 if(op==8){
  if(!solving())return;vec4 sums=vec4(0);
  if(i<N()){
   float r=work[i]-c[11]*work[3*N()+i];float z=r/work[4*N()+i];
   put_value(candidate(),P()+i,get_value(candidate(),P()+i)+c[11]*work[2*N()+i]);
   work[i]=r;work[N()+i]=z;sums=vec4(r*z,r*r,0,abs(r));
  }pressure_partial(sums);return;
 }
 if(op==9){if(!solving())return;vec4 s=global_reduce(true);if(i!=0)return;c[12]=s.x/max(c[9],1e-30);c[9]=s.x;c[8]++;c[18]++;c[13]=sqrt(s.y/max(c[10],1e-30));if(isnan(c[13])||isinf(c[13]))c[7]=2;else if(residual_converged(s,c[10]))c[6]=1;else if(c[8]>4096)c[7]=3;return;}
 if(op==10){if(!solving()||i>=N())return;work[2*N()+i]=work[N()+i]+c[12]*work[2*N()+i];return;}
}
